{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "types": [
      "@cloudflare/vitest-pool-workers/types",
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/runtime/**/*.ts",
    "tests/worker/**/*.ts",
    "vitest.worker.config.ts",
    "worker-configuration.d.ts"
  ]
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jin-kim-protected-portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-02",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "PROTECTED_MEDIA",
      "bucket_name": "jin-kim-portfolio-private"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "2026080201",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "SESSION_TTL_SECONDS": "7200"
  }
}
